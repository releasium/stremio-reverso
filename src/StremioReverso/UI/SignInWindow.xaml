<Window x:Class="StremioReverso.UI.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Reverso" Width="1000" Height="760" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Padding="10,6" Background="#FFF8E1" TextWrapping="Wrap"
                   Text="Log in with your Reverso account here (top-right of the page), then close this window. The popup uses the same login." />
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
