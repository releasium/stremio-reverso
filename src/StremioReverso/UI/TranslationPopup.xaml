<Window x:Class="StremioReverso.UI.TranslationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Width="480" Height="460" Left="-10000" Top="-10000"
        Background="#202124" BorderBrush="#555" BorderThickness="1">
    <Window.Resources>
        <Style TargetType="ButtonBase" x:Key="HeaderButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="32">
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close" Click="OnClose" Style="{StaticResource HeaderButton}" />
            <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" Content="📌" ToolTip="Keep open" Click="OnPin"
                          Style="{StaticResource HeaderButton}" />
            <Button DockPanel.Dock="Right" Content="↗" ToolTip="Open in browser" Click="OnOpenExternal"
                    Style="{StaticResource HeaderButton}" />
            <TextBlock x:Name="Heading" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="10,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
